# Copy to .env and fill in.  NEVER commit .env — it is gitignored.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Kalshi API credentials
# ---------------------------------------------------------------------------
# Get these from Kalshi -> Settings -> API Keys.  Creating a key shows you an
# RSA private key EXACTLY ONCE.  Save it to a file (e.g. ~/.kalshi/key.pem),
# then chmod 600 it, and point KALSHI_PRIVATE_KEY_PATH at it.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/.kalshi/key.pem

# "demo" or "prod".  ALWAYS start on demo.  Demo credentials only work on demo
# hosts and production credentials only work on production hosts.
KALSHI_ENV=demo

# ---------------------------------------------------------------------------
# THE SAFETY FLAG
# ---------------------------------------------------------------------------
# false  -> bot computes fair values and logs what it WOULD do. No orders sent.
# true   -> bot sends real orders with real money.
# This defaults to false everywhere. Setting it to true is a deliberate act.
ARMED=false

# ---------------------------------------------------------------------------
# Risk limits (dollars unless noted)
# ---------------------------------------------------------------------------
BANKROLL=2000
MAX_CONTRACTS_PER_ORDER=1
MAX_POSITION_PER_STRIKE=25
MAX_LOSS_PER_EVENT=15
MAX_LOSS_PER_DAY=50
KELLY_FRACTION=0.25

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Optional: alerts (leave blank to disable)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
